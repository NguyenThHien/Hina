# Copy sang .env rồi điền giá trị. Server đọc biến có tiền tố HINA_.
HINA_JWT_SECRET=change-me-to-at-least-32-characters
HINA_JWT_TTL_S=900
HINA_GPU_QUEUE_SIZE=16

# Mỗi khối AI: "stub" (mặc định) hoặc impl thật đã đăng ký trong ai/registry.py.
HINA_ASR=stub
HINA_NLU=stub
HINA_OCR=stub
HINA_DETECTOR=stub
HINA_DEPTH=stub
HINA_VLM=stub
HINA_TTS=stub

# NLU qua API ngoài: đặt HINA_NLU=http.
HINA_NLU_URL=https://nlu.frshdrp.vn
HINA_NLU_TIMEOUT_S=5

# TTS FPT.AI: đặt HINA_TTS=fpt và điền key.
HINA_FPT_API_KEY=
HINA_FPT_VOICE=banmai
HINA_FPT_SPEED=0
HINA_TTS_TIMEOUT_S=20
