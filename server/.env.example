# Copy sang .env rồi điền giá trị. Server đọc biến có tiền tố HINA_.
HINA_JWT_SECRET=change-me-to-at-least-32-characters
HINA_JWT_TTL_S=900
HINA_GPU_QUEUE_SIZE=16

# Mỗi khối AI: "stub" (mặc định) hoặc impl thật đã đăng ký trong ai/registry.py.
HINA_ASR=phowhisper
HINA_NLU=http
HINA_OCR=vietocr
HINA_DETECTOR=yolo
HINA_DEPTH=none
HINA_VLM=smolvlm
HINA_TTS=mms

# NLU qua API ngoài: đặt HINA_NLU=http.
HINA_NLU_URL=https://nlu.frshdrp.vn
HINA_NLU_TIMEOUT_S=5

# TTS FPT.AI: đặt HINA_TTS=fpt và điền key.
HINA_FPT_API_KEY=
HINA_FPT_VOICE=banmai
HINA_FPT_SPEED=0
HINA_TTS_TIMEOUT_S=20

# VLM Google Gemini: đặt HINA_VLM=gemini và điền key (aistudio.google.com/apikey).
HINA_GEMINI_API_KEY=
HINA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HINA_GEMINI_MODEL=gemini-3.5-flash
HINA_VLM_TIMEOUT_S=90

# Trang http://localhost:8000/debug xem luồng request. Chỉ bật khi dev (lộ ảnh/câu nói).
HINA_DEBUG=false

# Model tự host (*-api, header X-API-Key). Server Hina cùng mạng docker freshdrip thì đổi URL thành http://<container>:8000.
HINA_TEXT_DETECTOR=ppocr
HINA_PHOWHISPER_URL=https://stt.frshdrp.vn
HINA_PHOWHISPER_API_KEY=
HINA_PPOCR_URL=https://ocr-det.frshdrp.vn
HINA_PPOCR_API_KEY=
HINA_VIETOCR_URL=https://ocr.frshdrp.vn
HINA_VIETOCR_API_KEY=
HINA_YOLO_URL=https://yolo.frshdrp.vn
HINA_YOLO_API_KEY=
HINA_YOLO_CONF=0.35
HINA_SMOLVLM_URL=https://vlm.frshdrp.vn
HINA_SMOLVLM_API_KEY=
HINA_SMOLVLM_MAX_TOKENS=48
HINA_MMS_URL=https://tts.frshdrp.vn
HINA_MMS_API_KEY=
